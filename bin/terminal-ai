#!/usr/bin/env sh
# File: ./terminal-ai
# Description: Script to Communicate and Log with AI.
# Usage: ./terminal-ai [--output-dir=<OUTPUT_DIRECTORY_PATH>] [--output-file=<OUTPUT_FILE>] [--dry-run] [--help] [--verbose] <MSG_TO_SEND_TO_AI>

DEFAULT_MODEL="gpt-5-mini" # default
DEFAULT_THINK_HARDER_MODEL="o3" # More accurate and precise and faster
DEFAULT_TINY_MODEL="gpt-5-nano"
ALTERNATE_MODEL="o4-mini" 
ALTERNATE_THINK_HARDER_MODEL="gpt-5" # Less accurate and more general
ALTERNATE_TINY_MODEL="gpt-4.1-nano"

# ~~ normal ~~ 
# MODEL="$DEFAULT_MODEL" 
MODEL="$ALTERNATE_MODEL"
# ~~ harder ~~
# MODEL="$DEFAULT_THINK_HARDER_MODEL"
# MODEL="$ALTERNATE_THINK_HARDER_MODEL"
# ~~ tiny ~~
# MODEL="$DEFAULT_TINY_MODEL"
# MODEL="$ALTERNATE_TINY_MODEL"

if [ ! -z ${TAI_PRINT_MODELS} ]; then
MODELS_DISPLAY="$(cat <<EOF
Cheap Models
- gpt-5-mini
- gpt-5-nano
- gpt-4.1-mini
- gpt-4.1-nano
- gpt-4o-mini
- o1-mini
- o3-mini
- o4-mini
- codex-mini-latest

Expensive Models
- gpt-5
- gpt-5-chat-latest
- gpt-4.1
- gpt-4o
- o1
- o3
EOF
)"
echo "$MODELS_DISPLAY"
exit
fi

DEFAULT_APP_NAME="terminal-ai" # terminal-ai for prefix, as tai is for plugins.
APP_NAME="${TAI_APP_NAME:-$DEFAULT_APP_NAME}"

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

APP_CONFIG_DIR="${TAI_CONFIG_DIR:-$XDG_CONFIG_HOME/$APP_NAME}"
APP_DATA_DIR="${TAI_DATA_DIR:-$XDG_DATA_HOME/$APP_NAME}"

LOG_STORAGE_PATH="$APP_DATA_DIR/transcripts/default"
LOG_FILE="$(date --rfc-3339=date).md"

# Default values for optional arguments
DRY_RUN=0
VERBOSE=0
OUTPUT_DIR="$LOG_STORAGE_PATH"
OUTPUT_FILE="$LOG_FILE"
INPUT_FILE=""
ATTACHMENT=""

# Function to display help
show_help() {
  echo "Usage: ./terminal-ai [--output-dir=<OUTPUT_DIRECTORY_PATH>] [--output-file=<OUTPUT_FILE>] [--dry-run] [--input-file=<FILE_TO_ATTACH] [--help] [--verbose] [<MSG_TO_SEND_TO_AI>]"
  echo ""
  echo "Options:"
  echo "  --output-dir=<OUTPUT_DIRECTORY_PATH>   Specifies the directory where the log file will be stored. Defaults to /home/root/artifacts/logs/terminal-ai/transcripts."
  echo "  --output-file=<OUTPUT_FILE>            Specifies the name of the log file. Defaults to the current date in RFC-3339 format."
  echo "  --input-file=<INPUT_FILE>             Specify a file to attach."
  echo "  --env-file=<OPENAI_ENV_FILE>           If set, specifies the file path to source environment variables for OpenAI."
  echo "  --model=<MODEL>                        If set will use the model (overrides TAI_MODEL)"
  echo "  --dry-run                              If set, the script will not actually send the message to AI, but will log a placeholder response."
  echo "  --help                                 Show this help message and exit."
  echo "  --verbose                              If set, the entire response from AI will be outputted."
}

# Parse command-line arguments
while [[ "$1" == --* ]]; do
  case $1 in
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --output-dir=*)
      OUTPUT_DIR="${1#*=}"
      shift
      ;;
    --model=*)
      TAI_MODEL="${1#*=}"
      shift
      ;;
    --output-file=*)
      OUTPUT_FILE="${1#*=}"
      shift
      ;;
    --input-file=*)
      INPUT_FILE="${1#*=}"
      shift
      ;;
    --env-file=*)
      source "${1#*=}"
      shift
      ;;
    --help)
      show_help
      exit 0
      ;;
    -- )
      shift
      break
      ;;
    --verbose)
      VERBOSE=1
      shift
      ;;
    *)
      echo "Unknown option: $1"
      show_help
      exit 1
      ;;
  esac
done

# if output-dir set manually 
if [ "$LOG_STORAGE_PATH" != "$OUTPUT_DIR" ]; then
  # DO NOT CREAT IF PROVIDED PATH IS NOT A DIRECTORY 
  # AS IT MIGHT BE WRONG.
  if [ ! -d "$OUTPUT_DIR" ]; then
    echo "PROVIDED OUTPUT PATH IS NOT A VALID DIRECTORY: $OUTPUT_DIR" >&2; exit 1; 
  fi
fi

mkdir -p "$LOG_STORAGE_PATH"
touch "$LOG_STORAGE_PATH/$LOG_FILE"

SUPPLIED_PROMPT="$*"

if [ -z "$SUPPLIED_PROMPT" ]; then
  read -p "Enter prompt: " user_response
  if [ -z "$user_response" ]; then
    echo "Error: No message provided to send to AI."
    exit 1
  fi
  SUPPLIED_PROMPT="$user_response"
fi

if [ -n "$INPUT_FILE" ]; then
  if [ -f "$INPUT_FILE" ]; then
    ATTACHMENT=$(<"$INPUT_FILE")
  else
    echo "Unable to read file. Exiting..."
    exit 1
  fi
fi

Converse() {
  local supplied_prompt="$1"
  local attachment="$2"  
  
  HASH8() {
    local in="$1"
    echo "${in:-"NULL"}" | sha256sum | cut -c1-8
  }

  GenMessageId() {
    local speaker="$1"
    local timestamp="${2:-$(date --rfc-3339=seconds)}"
    local parent_message_id="${3:-$(HASH8 "NULL")}"
    local speech_id="$(HASH8 "$(printf "%s,%s" "$timestamp" "$speaker")")"
    local parent_speech_id="$(printf "%s" "$parent_message_id" | cut -c1-8)" # THIS SHOULD BE LIKE THE HASH OF "NULL" or the speech part of the messge id
    local message_id="$(printf "%s-%s" "$speech_id" "$parent_speech_id")"
    echo "$message_id"
  }

  if [ -z "$attachment" ]; then
    user_speech=$(Speak "USER" "$supplied_prompt")
  else
    user_speech=$(Speak "USER" "${supplied_prompt}\n--- (@attachment) ---\n${attachment}")
  fi

  _USER_TS="$(date --rfc-3339=seconds)"
  _USER_MSG_ID="$(GenMessageId "USER" "$_USER_TS")"

  Record "USER" "$user_speech" "$_USER_TS" "$_USER_MSG_ID"

  _AI_TS="$(date --rfc-3339=seconds)"
  _AI_MSG_ID="$(GenMessageId "AI" "$_AI_TS" "$_USER_MSG_ID")"

  ai_speech="$(Speak "AI" "$user_speech")"
  Record "AI" "$ai_speech" "$_AI_TS" "$_AI_MSG_ID"
}

Speak() {
  local speaker="$1"
  local prompt="$2"
  local parent_id="$3"

  # NEED TO ADD METADATA HERE FOR MessageID, MessageID, and Model
  if [ "$speaker" == "USER" ]; then
    UserSpeak "$prompt"
  elif [ "$speaker" == "AI" ]; then
    AISpeak "$prompt"
  fi
}

Record() {
  # timestamp to Speak
  local speaker="$1"
  local speech="$2"
  local speech_ts="$3"
  local message_id="$4"
  local speech_metadata="$(printf "[%s, %s, %s]" "$speech_ts" "$speaker" "$message_id")"

  # SPEECH METADATA NEEDS TO BE CONSISTENT WHEN CALLED FROM AI OR USER.
  # THIS WILL BE WHERE TAI_OPTION Will need to toggle.

  indent() {
     printf '%s\n' "$1" | sed 's/^/ /'
  }

  
  playback() {
   _metadata="${1:-$speech_metadata}"
   _speech="${2:-$speech}"
   printf '%s\n%s\n\n---\n' "$_metadata" "$_speech"
  }
  playback 

  # indented speech
  ispeech=$(indent "$speech")
  # playback "$speech_metadata" "$ispeech" >> /tmp/out
  # cat /tmp/out
  playback "$speech_metadata" "$ispeech" >> "$OUTPUT_DIR/$OUTPUT_FILE"

}

UserSpeak() {
  local user_speech="$1"
  echo "$user_speech"
}


AISpeak() {
  local prompt="$1"
  local ai_speech
  if [ "$DRY_RUN" -eq 1 ]; then
    ai_speech="<AI Response>"
  else
    
    INSTRUCTION="You are a Terminal Based Assistant, which provides Responses Compliant to CommonMark Spec (unless otherwise specified)."
    request_body=$(jq -n \
      --arg model "${TAI_MODEL:-$MODEL}" \
      --arg system "system" \
      --arg user "user" \
      --arg instruction "$INSTRUCTION" \
      --arg message "$prompt" \
      '{
          model: $model,
          messages: [
            {
              role: $system,
              content: $instruction
            },
            {
              role: $user,
              content: $message
            }
          ]
          }
        ')

    # CHANGE TO RESPONSE
    # NEED TO SUBSTITUTE TO RESPONSE.
    # response=$(curl -s https://api.openai.com/v1/response \
    response=$(curl -s https://api.openai.com/v1/chat/completions \
      -H "Content-Type: application/json" \
      -H "Authorization: Bearer $OPENAI_API_KEY" \
      -H "OpenAI-Project: $OPENAI_PROJECT_ID" \
      -d "$request_body")
    if [ "$VERBOSE" -eq 1 ]; then
      ai_speech="$response"
    else
      metadata=$(ExtractMetadata "$response")     
      echo "$metadata"
      ai_speech=$(echo "$response" | jq -r '.choices[0].message.content')
    fi
  fi
  echo "$ai_speech"
}

ExtractMetadata() {
  local response="$1"
  # Will just put all tokens per API respond kind in token_usage="$(endpoint_token_filter "openai")
  #  where extract_token_metadata(){
  #     if [ ... some operation ]; { echo $response} | jq -r '.usage' };
  #     ,
  #  }
  # Using jq to extract the required fields from the JSON response
  local total_tokens
  local prompt_tokens
  local completion_tokens
  local conversation_id
  total_tokens=$(echo "$response" | jq -r '.usage.total_tokens')
  prompt_tokens=$(echo "$response" | jq -r '.usage.prompt_tokens')
  completion_tokens=$(echo "$response" | jq -r '.usage.completion_tokens')
  conversation_id=$(echo "$response" | jq -r '.id')
  agent_used=$(echo "$response" | jq -r '.model')

  # Outputting the extracted metadata
  echo "<!--{ \"model\": \"${agent_used}\", \"id\": \"${conversation_id}\", \"usage\": {\"total\": $total_tokens, \"prompt\": ${prompt_tokens}, \"completion\": ${completion_tokens}} }-->"
}

Main() {
  if [ "$DRY_RUN" -eq 0 ]; then
    if [ -z "$OPENAI_API_KEY" ] || [ -z "$OPENAI_PROJECT_ID" ]; then
      Record "SYSTEM" "Error: OPENAI_API_KEY or OPENAI_PROJECT_ID is not set."
      exit 1
    fi
  fi
  Converse "$SUPPLIED_PROMPT" "$ATTACHMENT"
}

Main
