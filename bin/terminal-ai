#!/bin/sh
# File: ./terminal-ai
# Description: Script to Communicate and Log with AI.
# Usage: ./terminal-ai [--output-dir=<OUTPUT_DIRECTORY_PATH>] [--output-file=<OUTPUT_FILE>] [--dry-run] [--help] [--verbose] <MSG_TO_SEND_TO_AI>

DEFAULT_APP_NAME="tai-dev"

# Config (defaults to $HOME/.config; analogous to /etc)
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

# Cache (defaults to $HOME/.cache; analogous to /var/cache)
# XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"  # Uncomment to explicitly set if above is commented.

# Data (defaults to $HOME/.local/share; analogous to /usr/share)
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

# State (defaults to $HOME/.local/state; analogous to /var/lib)
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Runtime (no default required by spec; see handling below)
# XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}"  # Leave unset to allow system (e.g., pam_systemd) to provide /run/user/$UID.

#   APP_NAME=terminal-ai
#   APP_CONFIG_DIR="$XDG_CONFIG_HOME/$APP_NAME"
#   APP_CACHE_DIR="$XDG_CACHE_HOME/$APP_NAME"
#   APP_DATA_DIR="$XDG_DATA_HOME/$APP_NAME"
#   APP_STATE_DIR="$XDG_STATE_HOME/$APP_NAME"
#   APP_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}/$APP_NAME"  # only if XDG_RUNTIME_DIR is available
# ensure_dir "$APP_CONFIG_DIR" "$APP_CACHE_DIR" "$APP_DATA_DIR" "$APP_STATE_DIR"
# [ -n "${XDG_RUNTIME_DIR:-}" ] && ensure_dir "$APP_RUNTIME_DIR" || :

---

# --- 

APP_NAME="${TAI_APP_NAME:-$DEFAULT_APP_NAME}"
APP_CONFIG_PATH="${TAI_CONFIG_PATH:-$XDG_CONFIG_HOME}/$APP_NAME"

# MAKE THE FOLLOWING BE XDG_COMPLIANT

echo "$APP_CONFIG_PATH"


LOG_STORAGE_PATH="$HOME/repos/terminal-ai-transcripts/default"
LOG_FILE="`date --rfc-3339=date`.md"
mkdir -p "$LOG_STORAGE_PATH"
touch "$LOG_STORAGE_PATH/$LOG_FILE"

# Default values for optional arguments
DRY_RUN=0
VERBOSE=0
OUTPUT_DIR="$LOG_STORAGE_PATH"
OUTPUT_FILE="$LOG_FILE"
INPUT_FILE=""
ATTACHMENT=""

# Function to display help
show_help() {
  echo "Usage: ./terminal-ai [--output-dir=<OUTPUT_DIRECTORY_PATH>] [--output-file=<OUTPUT_FILE>] [--dry-run] [--input-file=<FILE_TO_ATTACH] [--help] [--verbose] [<MSG_TO_SEND_TO_AI>]"
  echo ""
  echo "Options:"
  echo "  --output-dir=<OUTPUT_DIRECTORY_PATH>   Specifies the directory where the log file will be stored. Defaults to /home/root/artifacts/logs/terminal-ai/transcripts."
  echo "  --output-file=<OUTPUT_FILE>            Specifies the name of the log file. Defaults to the current date in RFC-3339 format."
  echo "  --input-file=<INPUT_FILE>             Specify a file to attach."
  echo "  --env-file=<OPENAI_ENV_FILE>           If set, specifies the file path to source environment variables for OpenAI."
  echo "  --dry-run                              If set, the script will not actually send the message to AI, but will log a placeholder response."
  echo "  --help                                 Show this help message and exit."
  echo "  --verbose                              If set, the entire response from AI will be outputted."
}

# Parse command-line arguments
while [[ "$1" == --* ]]; do
  case $1 in
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --output-dir=*)
      output_dir="${1#*=}"
      shift
      ;;
    --output-file=*)
      OUTPUT_FILE="${1#*=}"
      shift
      ;;
    --input-file=*)
      INPUT_FILE="${1#*=}"
      shift
      ;;
    --env-file=*)
      source "${1#*=}"
      shift
      ;;
    --help)
      show_help
      exit 0
      ;;
    -- )
      shift
      break
      ;;
    --verbose)
      VERBOSE=1
      shift
      ;;
    *)
      echo "Unknown option: $1"
      show_help
      exit 1
      ;;
  esac
done

SUPPLIED_PROMPT="$*"

if [ -z "$SUPPLIED_PROMPT" ]; then
  read -p "Enter prompt: " user_response
  if [ -z "$user_response" ]; then
    echo "Error: No message provided to send to AI."
    exit 1
  fi
  SUPPLIED_PROMPT="$user_response"
fi

if [ -n "$INPUT_FILE" ]; then
  if [ -f "$INPUT_FILE" ]; then
    ATTACHMENT=$(<"$INPUT_FILE")
  else
    echo "Unable to read file. Exiting..."
    exit 1
  fi
fi

Converse() {
  local supplied_prompt="$1"
  local attachment="$2"  
  if [ -z "$attachment" ]; then
    user_speech=$(Speak "USER" "$supplied_prompt")
  else
    user_speech=$(Speak "USER" "${supplied_prompt}\n--- (@attachment) ---\n${attachment}")
  fi
  Record "USER" "$user_speech"

  ai_speech=$(Speak "AI" "$user_speech")
  Record "AI" "$ai_speech"
}

Speak() {
  local speaker="$1"
  local prompt="$2"
  if [ "$speaker" == "USER" ]; then
    UserSpeak "$prompt"
  elif [ "$speaker" == "AI" ]; then
    AISpeak "$prompt"
  fi
}

Record() {
  local speaker="$1"
  local speech="$2"
  local speech_metadata="[`date --rfc-3339=seconds`, $speaker]" 
  # SPEECH METADATA NEEDS TO BE CONSISTENT WHEN CALLED FROM AI OR USER.
  echo 
  echo "$speech_metadata"
  echo -e "$speech"
  echo 
  echo "---"

  echo >> "$OUTPUT_DIR/$OUTPUT_FILE"
  echo "$speech_metadata" >> "$OUTPUT_DIR/$OUTPUT_FILE"
  echo -e "$speech" >> "$OUTPUT_DIR/$OUTPUT_FILE"
  echo >> "$OUTPUT_DIR/$OUTPUT_FILE"
  echo "---" >> "$OUTPUT_DIR/$OUTPUT_FILE"
}

UserSpeak() {
  local user_speech="$1"
  echo "$user_speech"
}


AISpeak() {
  local prompt="$1"
  local ai_speech
  if [ "$DRY_RUN" -eq 1 ]; then
    ai_speech="<AI Response>"
  else
    # TOKEN BUCKET `OPENAI-10MILLION-FREE`
    # https://platform.openai.com/settings/organization/data-controls/sharing to see price
    # LIMIT: 10 million tokens per day
    # MODELS:
    # - gpt-5-mini
    # - gpt-5-nano
    # - gpt-4.1-mini
    # - gpt-4.1-nano
    # - gpt-4o-mini
    # - o1-mini
    # - o3-mini
    # - o4-mini
    # - codex-mini-latest
    #
    # TOKEN BUCKET `OPENAI-1MILLION-FREE` (--think-harder)
    # LIMIT: 1 million tokens per day
    # MODELS:
    #   - gpt-5*
    #   - gpt-5-chat-latest
    #   - gpt-4.1
    #   - gpt-4o
    #   - o1
    #   - o3
    #
    # Need to add deepseek
    # - deepseek-reasoning
    # - deepseek-completion
    # MODEL="gpt-4.1"
    
    # override with TAI__MODEL=...
    # todo: reasoning support
    # todo: decide command params and implementation
    #       for ...

    DEFAULT_MODEL="gpt-5-mini" # default
    DEFAULT_THINK_HARDER_MODEL="o3" # --think=harder,different
    DEFAULT_TINY_MODEL="gpt-5-nano"
    ALTERNATE_MODEL="o4-mini" # --think-different -t harder -t different 
    ALTERNATE_THINK_HARDER_MODEL="gpt-5" # --think=harder  OR maybe named differently
    ALTERNATE_TINY_MODEL="gpt-4.1-nano"
    
    # ~~ normal ~~ 
    # MODEL="$DEFAULT_MODEL" 
    # MODEL="$ALTERNATE_MODEL"
    # ~~ harder ~~
    # MODEL="$DEFAULT_THINK_HARDER_MODEL"
    MODEL="$ALTERNATE_THINK_HARDER_MODEL"
    # ~~ tiny ~~
    # MODEL="$DEFAULT_TINY_MODEL"
    # MODEL="$ALTERNATE_TINY_MODEL"
    INSTRUCTION="You are a Terminal Based Assistant, which provides Responses Compliant to CommonMark Spec (unless otherwise specified)."
    # NEED TO BE ABLE TO SUPPORT RESPONSE API 
    request_body=$(jq -n \
      --arg model "$MODEL" \
      --arg system "system" \
      --arg user "user" \
      --arg instruction "$INSTRUCTION" \
      --arg message "$prompt" \
      '{
          model: $model,
          messages: [
            {
              role: $system,
              content: $instruction
            },
            {
              role: $user,
              content: $message
            }
          ]
          }
        ')
    # NEED ONE FOR DEEPSEEK.   
    response=$(curl -s https://api.openai.com/v1/chat/completions \
      -H "Content-Type: application/json" \
      -H "Authorization: Bearer $OPENAI_API_KEY" \
      -H "OpenAI-Project: $OPENAI_PROJECT_ID" \
      -d "$request_body")
    if [ "$VERBOSE" -eq 1 ]; then
      ai_speech="$response"
    else
      metadata=$(ExtractMetadata "$response")     
      echo "$metadata"
      ai_speech=$(echo "$response" | jq -r '.choices[0].message.content')
    fi
  fi
  echo "$ai_speech"
}


ExtractMetadata() {
  local response="$1"
  
  # Using jq to extract the required fields from the JSON response
  local total_tokens
  local prompt_tokens
  local completion_tokens
  local conversation_id
  total_tokens=$(echo "$response" | jq -r '.usage.total_tokens')
  prompt_tokens=$(echo "$response" | jq -r '.usage.prompt_tokens')
  completion_tokens=$(echo "$response" | jq -r '.usage.completion_tokens')
  conversation_id=$(echo "$response" | jq -r '.id')
  agent_used=$(echo "$response" | jq -r '.model')

  # Outputting the extracted metadata
  echo "<!--{ \"model\": \"${agent_used}\", \"id\": \"${conversation_id}\", \"usage\": {\"total\": $total_tokens, \"prompt\": ${prompt_tokens}, \"completion\": ${completion_tokens}} }-->"
}

Main() {
  if [ "$DRY_RUN" -eq 0 ]; then
    if [ -z "$OPENAI_API_KEY" ] || [ -z "$OPENAI_PROJECT_ID" ]; then
      Record "SYSTEM" "Error: OPENAI_API_KEY or OPENAI_PROJECT_ID is not set."
      exit 1
    fi
  fi
  Converse "$SUPPLIED_PROMPT" "$ATTACHMENT"
}

Main
